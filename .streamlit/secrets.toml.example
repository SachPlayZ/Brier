# Copy these keys into Streamlit Community Cloud > App settings > Secrets.
# Never commit the real values.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DJANGO_SECRET_KEY = "replace-with-at-least-50-random-characters-generated-securely"
DJANGO_DEBUG = "0"
DJANGO_ALLOWED_HOSTS = ".streamlit.app"
BRIER_ADMIN_USERNAME = "finance"
BRIER_ADMIN_PASSWORD = "choose-a-strong-initial-password"
BRIER_ADMIN_EMAIL = "finance@example.com"
# Keep disabled for an invite-only deployment. Set to "1" only if public
# employee self-registration is intentional.
BRIER_ALLOW_SIGNUP = "0"
