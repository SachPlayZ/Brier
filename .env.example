DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
# SQLite by default. Switch to Postgres by pointing this at a PG instance:
# DATABASE_URL=postgres://user:pass@localhost:5432/project5
DATABASE_URL=sqlite:///db.sqlite3

# Only needed if Tesseract is installed somewhere non-standard.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Streamlit bootstrap. Keep signup off unless self-registration is intentional.
# BRIER_ADMIN_USERNAME=finance
# BRIER_ADMIN_PASSWORD=replace-with-a-strong-password
# BRIER_ADMIN_EMAIL=finance@example.com
BRIER_ALLOW_SIGNUP=1

# Optional S3-compatible receipt storage. Leave the bucket unset to use the
# local/database fallback during development.
# BRIER_OBJECT_STORAGE_BUCKET=assets
# BRIER_OBJECT_STORAGE_REGION=us-east-1
# BRIER_OBJECT_STORAGE_ENDPOINT_URL=https://your-s3-compatible-endpoint
# BRIER_OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key
# BRIER_OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-key
# BRIER_OBJECT_STORAGE_PREFIX=receipts
# Required only for local Streamlit runs that intentionally use demo SQLite.
BRIER_LOCAL_DEMO=1
